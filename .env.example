# flocc setup and flocc keys take these before they ask. Fill in what you have; leave the rest empty.
# Keep this file private: flocc sets it to mode 600. A variable in the shell environment wins over this file.

# Linear: linear.app/settings/account/security, New API key, full access.
FLOCC_LINEAR_API_KEY=

# GitHub, read-only: github.com/settings/personal-access-tokens, fine-grained, your repos, read on contents, pull requests, issues, commit statuses and actions.
FLOCC_GITHUB_AGENT_TOKEN=

# GitHub, publishing: github.com/settings/personal-access-tokens, fine-grained, your repos, write on contents and pull requests.
FLOCC_GITHUB_PUBLISH_TOKEN=

# Tailscale OAuth client secret (tskey-client-...): login.tailscale.com/admin/settings/oauth, scopes auth keys (write) and devices core (write) with tag:flocc-host, and policy file (read).
FLOCC_TAILSCALE_OAUTH_SECRET=
# Optional: the client ID, when you want id:secret stored.
FLOCC_TAILSCALE_OAUTH_CLIENT_ID=
