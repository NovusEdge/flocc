{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Read", "Glob", "Grep", "WebFetch", "WebSearch", "Edit", "Write", "NotebookEdit", "mcp__*", "Monitor",
      "Agent", "Workflow", "CronCreate", "ScheduleWakeup", "RemoteTrigger"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "/opt/cardinal/plugin/bin/only-executor" }]
      }
    ]
  }
}
