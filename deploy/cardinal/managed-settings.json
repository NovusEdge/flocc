{
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": ["Bash(/opt/cardinal/plugin/bin/executor:*)", "Bash(/opt/cardinal/plugin/bin/agent-shell:*)", "Skill", "AskUserQuestion"],
    "deny": [
      "Read", "Glob", "Grep", "WebFetch", "WebSearch", "Edit", "Write", "NotebookEdit", "mcp__*", "Monitor",
      "Agent", "Workflow", "CronCreate", "ScheduleWakeup", "RemoteTrigger"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "/opt/cardinal/plugin/bin/only-executor" }]
      }
    ]
  }
}
