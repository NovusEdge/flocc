[Unit]
Description=flocc A2A endpoint

[Service]
Environment=PATH=%h/.local/bin:%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/flocc a2a serve
# A user unit cannot order itself after the system tailscaled, so binding the tailnet address can
# fail at boot until tailscaled is up.
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
