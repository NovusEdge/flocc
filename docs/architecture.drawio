<mxfile host="app.diagrams.net">
  <diagram id="arch" name="Poller architecture">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="host" value="My machine or VM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="260" y="120" width="640" height="560" as="geometry" />
        </mxCell>
        <mxCell id="container" value="Reference dev container, non-root user" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="560" y="160" width="320" height="300" as="geometry" />
        </mxCell>

        <mxCell id="linear" value="&lt;b&gt;Linear&lt;/b&gt;&lt;br&gt;NF team issues&lt;br&gt;assigned to me,&lt;br&gt;label &lt;code&gt;claude&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="170" height="110" as="geometry" />
        </mxCell>
        <mxCell id="anthropic" value="&lt;b&gt;My claude.ai subscription&lt;/b&gt;&lt;br&gt;Claude Code login on this machine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="610" y="20" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="github" value="&lt;b&gt;GitHub&lt;/b&gt;&lt;br&gt;fine-grained token&lt;br&gt;draft PR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="960" y="530" width="170" height="90" as="geometry" />
        </mxCell>

        <mxCell id="timer" value="&lt;b&gt;systemd timer&lt;/b&gt;&lt;br&gt;every 3 min" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="290" y="160" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="poller" value="&lt;b&gt;Poller script&lt;/b&gt;&lt;div style=&quot;text-align:left&quot;&gt;1. find ready issues&lt;br&gt;2. skip + comment if no&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;acceptance criteria&lt;br&gt;3. move to In Progress&lt;br&gt;4. map label/project to repo&lt;br&gt;5. git worktree add, ./setup&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="290" y="260" width="220" height="150" as="geometry" />
        </mxCell>
        <mxCell id="worktree" value="&lt;b&gt;git worktree&lt;/b&gt;&lt;br&gt;one per issue" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=8;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="330" y="460" width="140" height="70" as="geometry" />
        </mxCell>

        <mxCell id="tester" value="&lt;b&gt;Session 1: tester&lt;/b&gt;&lt;br&gt;&lt;code&gt;claude -p&lt;/code&gt;, auto mode&lt;br&gt;commits tests that pass only&lt;br&gt;on correct behavior" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="590" y="200" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="impl" value="&lt;b&gt;Session 2: implementer&lt;/b&gt;&lt;br&gt;fresh &lt;code&gt;claude -p&lt;/code&gt;&lt;br&gt;implements until they pass" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="590" y="320" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="caps" value="--max-turns 60, --max-budget-usd 6 (untested)" style="text;html=1;fontSize=10;fontColor=#b46504;align=center;" vertex="1" parent="1">
          <mxGeometry x="590" y="410" width="260" height="30" as="geometry" />
        </mxCell>

        <mxCell id="publish" value="&lt;b&gt;Script publishes, not the agent&lt;/b&gt;&lt;div style=&quot;text-align:left&quot;&gt;just check&lt;br&gt;name branch, push&lt;br&gt;gh pr create --draft, Fixes NF-123&lt;br&gt;comment PR link on the issue&lt;br&gt;design question: comment, end run&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="590" y="500" width="260" height="140" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="starts" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="timer" target="poller">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="personal API key&lt;br&gt;read + update" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=block;fontSize=10;" edge="1" parent="1" source="poller" target="linear">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="poller" target="worktree">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="mounted" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="worktree" target="tester">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="540" y="495" /><mxPoint x="540" y="235" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e5" value="then" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="tester" target="impl">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="signed-in session" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="container" target="anthropic">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="exits" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="impl" target="publish">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="push, draft PR" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="publish" target="github">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="PR link or question" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="publish" target="linear">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="720" y="720" /><mxPoint x="125" y="720" /></Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="open-auth" value="Open: subscription use on company&lt;br&gt;repos needs the company's OK." style="shape=note;whiteSpace=wrap;html=1;size=12;dashed=1;fillColor=#fff2cc;strokeColor=#d79b00;fontColor=#b46504;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="860" y="20" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="open-lock" value="Open: lock so two runs&lt;br&gt;cannot overlap (flock)" style="shape=note;whiteSpace=wrap;html=1;size=12;dashed=1;fillColor=#fff2cc;strokeColor=#d79b00;fontColor=#b46504;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="open-map" value="Open: label/project to repo mapping;&lt;br&gt;recovery of issues stuck In Progress" style="shape=note;whiteSpace=wrap;html=1;size=12;dashed=1;fillColor=#fff2cc;strokeColor=#d79b00;fontColor=#b46504;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="440" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="open-tests" value="Open: reject implementer&lt;br&gt;changes to test files" style="shape=note;whiteSpace=wrap;html=1;size=12;dashed=1;fillColor=#fff2cc;strokeColor=#d79b00;fontColor=#b46504;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="920" y="330" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="open-parallel" value="Open: several issues at once?&lt;br&gt;One container per worktree, capped;&lt;br&gt;all share one subscription's limits" style="shape=note;whiteSpace=wrap;html=1;size=12;dashed=1;fillColor=#fff2cc;strokeColor=#d79b00;fontColor=#b46504;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="920" y="170" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n5" style="endArrow=none;dashed=1;html=1;strokeColor=#d79b00;" edge="1" parent="1" source="open-parallel" target="container">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n1" style="endArrow=none;dashed=1;html=1;strokeColor=#d79b00;" edge="1" parent="1" source="open-auth" target="anthropic">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n2" style="endArrow=none;dashed=1;html=1;strokeColor=#d79b00;" edge="1" parent="1" source="open-lock" target="timer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n3" style="endArrow=none;dashed=1;html=1;strokeColor=#d79b00;" edge="1" parent="1" source="open-map" target="poller">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n4" style="endArrow=none;dashed=1;html=1;strokeColor=#d79b00;" edge="1" parent="1" source="open-tests" target="publish">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
