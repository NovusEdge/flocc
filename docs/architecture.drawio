          <mxGeometry x="240" y="120" width="760" height="600" as="geometry" />
        </mxCell>
        <mxCell id="svc" value="linear-agents service (Python, one run per tick)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;arcSize=4;" vertex="1" parent="1">
