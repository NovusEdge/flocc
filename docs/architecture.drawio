        <mxCell id="s1" value="&lt;b&gt;NF-123&lt;/b&gt; &lt;code&gt;claude --remote-control NF-123&lt;/code&gt;&lt;br&gt;tester session, then implementer session&lt;br&gt;plugin: skills (tester, implementer, escalate, coordinate)&lt;br&gt;hooks: SessionStart loads issue + handoff, PreCompact writes handoff&lt;br&gt;status line writes usage + context to state dir" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
