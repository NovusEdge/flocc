#!/bin/sh
# Stands in for claude in tests/test_process.py.
mode=$(cat "$FLOCC_STATE/fake-mode" 2>/dev/null || echo done)
case "$mode" in
  done)
    git commit -q --allow-empty -m "fake tests"
    flocc done --summary "fake $FLOCC_PHASE" ;;
  handoff)
    echo "fake note" > "$FLOCC_STATE/handoff.md"
    flocc handoff-ready ;;
  crash)
    exit 3 ;;
esac
exec sleep 600
